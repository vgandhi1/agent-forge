# Copy this to `.env` in the same folder as `main.py`.
# AgentForge loads this file via python-dotenv. For `uv run`, you can also use:
#   uv run --env-file .env python main.py ...
#
# Optional — in your **shell** (not in this file), point uv at an env file:
#   export UV_ENV_FILE=.env
# See: https://docs.astral.sh/uv/reference/cli/#uv-run

ANTHROPIC_API_KEY=your_api_key_here

# LLM backend: anthropic (default) or ollama
# AGENTFORGE_LLM_PROVIDER=ollama

# Ollama (when AGENTFORGE_LLM_PROVIDER=ollama). Base URL is validated (loopback by default).
# AGENTFORGE_OLLAMA_HOST=http://127.0.0.1:11434
# If Ollama runs on a Windows host and AgentForge is in WSL2, point at the WSL2 gateway IP
# (find it with: ip route | grep default) and allow the private IP below:
# AGENTFORGE_OLLAMA_HOST=http://172.17.48.1:11434
# Optional: allow Docker/LAN hosts that resolve to private IPs (SSRF risk — dev only).
# Required for the Windows-host/WSL2 address above.
# AGENTFORGE_OLLAMA_TRUST_LAN=1

# --- Recommended local (Ollama) model config -------------------------------------------
# Use qwen2.5 (advertises the `tools` capability). Do NOT use llama3.2 / a bare 7B for the
# reviewer: it cannot reliably emit the structured verdict, which trips the reviewer preflight
# and (without it) sends every audit into a reject->revise death-spiral. Match model to role.
#
# Pull the tags first:
#   ollama pull qwen2.5:7b-instruct
#   ollama pull qwen2.5:14b-instruct
#   ollama pull qwen2.5-coder:14b
#   ollama pull qwen2.5-coder:7b
#
# VRAM sizing (q4) for the structure-heavy roles (reviewer/pm/architect/lead):
#   ~8 GB  -> qwen2.5:7b-instruct  (reviewer may still flake; the preflight aborts early)
#   ~16 GB -> qwen2.5:14b-instruct (sweet spot — clears the F1/F2 failure modes)
#   24 GB+ -> qwen2.5:32b-instruct (best local fidelity)

# Default Ollama model if a per-role override is not set (tool-capable model required).
# AGENTFORGE_OLLAMA_MODEL=qwen2.5:7b-instruct

# Per-role Ollama models (optional; each role can use a different tag). Structure-heavy roles
# (reviewer, pm, architect, lead) get the stronger tag; cheap roles fall back to the default.
# AGENTFORGE_OLLAMA_MODEL_LEAD=qwen2.5:14b-instruct
# AGENTFORGE_OLLAMA_MODEL_PM=qwen2.5:14b-instruct
# AGENTFORGE_OLLAMA_MODEL_ARCHITECT=qwen2.5:14b-instruct
# AGENTFORGE_OLLAMA_MODEL_REVIEWER=qwen2.5:14b-instruct
# AGENTFORGE_OLLAMA_MODEL_BACKEND=qwen2.5-coder:14b
# AGENTFORGE_OLLAMA_MODEL_QA=qwen2.5-coder:7b
# AGENTFORGE_OLLAMA_MODEL_DEVOPS=qwen2.5:7b-instruct
# AGENTFORGE_OLLAMA_MODEL_DATA_ENGINEER=qwen2.5:7b-instruct
# AGENTFORGE_OLLAMA_MODEL_ML_ENGINEER=qwen2.5:7b-instruct
# Verify resolution without any API call:  agentforge --dry-run  (or the agentforge-dry-run skill)

# Guard bypasses (default off — leave unset for the fail-closed behavior):
# AGENTFORGE_SKIP_REVIEWER_PREFLIGHT=1   # skip the reviewer verdict smoke-test
# AGENTFORGE_SKIP_GROUNDING=1            # skip the PM/architect goal-grounding gate
# AGENTFORGE_SKIP_DOC_QUALITY=1          # skip the thin/placeholder spec-doc deploy check
# AGENTFORGE_ALLOW_QUALITY_DEBT=1        # ship even with unresolved review findings / thin docs

# Optional: project root (default: current working directory). DB and paths resolve here.
# AGENTFORGE_ROOT=/path/to/agents

# Optional: workspace folder name under AGENTFORGE_ROOT (default: workspace)
# AGENTFORGE_WORKSPACE=workspace

# Optional: SQLite DB filename under AGENTFORGE_ROOT (default: agentforge.db)
# AGENTFORGE_DB=agentforge.db

# Optional: override default Anthropic model (default: claude-sonnet-4-6)
# AGENTFORGE_MODEL=claude-opus-4-7
# Per-role Anthropic models (optional):
# AGENTFORGE_MODEL_LEAD=claude-sonnet-4-6
# AGENTFORGE_MODEL_PM=claude-sonnet-4-6
# AGENTFORGE_MODEL_ARCHITECT=claude-sonnet-4-6
# AGENTFORGE_MODEL_BACKEND=claude-sonnet-4-6
# AGENTFORGE_MODEL_QA=claude-sonnet-4-6
# AGENTFORGE_MODEL_DEVOPS=claude-sonnet-4-6
# AGENTFORGE_MODEL_REVIEWER=claude-sonnet-4-6

# Optional: enable extended thinking (default: false)
# AGENTFORGE_THINKING=true
# AGENTFORGE_THINKING_BUDGET=8000

# Optional: Anthropic API retries on rate limit / 5xx / connection errors (default: 4)
# AGENTFORGE_API_RETRIES=4

# Optional: deploy gate (default: off). Require human sign-off before the deploy step;
# commit the generated workspace/dailyease app to its own git repo on deploy.
# CLI equivalents: --deploy-gate / --auto-approve / --deploy-commit
# AGENTFORGE_DEPLOY_GATE=1
# AGENTFORGE_DEPLOY_COMMIT=1

# Optional: backend shows a build plan for Lead confirmation before writing code (default: off).
# CLI equivalent: --plan-gate
# AGENTFORGE_PLAN_GATE=1
# Resume (skip phases already completed for the same goal) is CLI-only: --resume
