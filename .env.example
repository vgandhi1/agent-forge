# Copy this to `.env` in the same folder as `main.py`.
# AgentForge loads this file via python-dotenv. For `uv run`, you can also use:
#   uv run --env-file .env python main.py ...
#
# Optional — in your **shell** (not in this file), point uv at an env file:
#   export UV_ENV_FILE=.env
# See: https://docs.astral.sh/uv/reference/cli/#uv-run

ANTHROPIC_API_KEY=your_api_key_here

# Optional: project root (default: current working directory). DB and paths resolve here.
# AGENTFORGE_ROOT=/path/to/agents

# Optional: workspace folder name under AGENTFORGE_ROOT (default: workspace)
# AGENTFORGE_WORKSPACE=workspace

# Optional: SQLite DB filename under AGENTFORGE_ROOT (default: agentforge.db)
# AGENTFORGE_DB=agentforge.db

# Optional: override default model (default: claude-sonnet-4-6)
# AGENTFORGE_MODEL=claude-opus-4-7

# Optional: enable extended thinking (default: false)
# AGENTFORGE_THINKING=true
# AGENTFORGE_THINKING_BUDGET=8000
